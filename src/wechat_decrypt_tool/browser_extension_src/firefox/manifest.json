{
    "manifest_version": 3,
    "name": "AI对话导出 word/json/md",
    "version": "2026.11.2.1",
    "description": "支持DeepSeek、纳米AI、腾讯元宝、Kimi、通义千问（qianwen.com）、讯飞星火、豆包的对话导出（JSON/Markdown/Word），独立扩展版，无需篡改猴。可在面板中设置自动保存的目录与格式，支持一键上传会话到数据库。",
    "browser_specific_settings": {
        "gecko": {
            "id": "ai-dialog-export@scrollmerge.extension",
            "strict_min_version": "128.0"
        }
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "AI对话导出 · 保存设置"
    },
    "permissions": [
        "downloads",
        "storage"
    ],
    "host_permissions": [
        "https://api.any2card.com/*",
        "http://114.55.254.123/*"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "*://chat.deepseek.com/*",
                "*://bot.n.cn/*",
                "*://yuanbao.tencent.com/*",
                "*://*.kimi.com/*",
                "*://*.tongyi.com/*",
                "*://qianwen.com/*",
                "*://*.qianwen.com/*",
                "*://*.xfyun.cn/*",
                "*://*.doubao.com/*"
            ],
            "js": [
                "bridge.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "*://chat.deepseek.com/*",
                "*://bot.n.cn/*",
                "*://yuanbao.tencent.com/*",
                "*://*.kimi.com/*",
                "*://*.tongyi.com/*",
                "*://qianwen.com/*",
                "*://*.qianwen.com/*",
                "*://*.xfyun.cn/*",
                "*://*.doubao.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ]
}
